{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "build_msvc.bat",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Run engine tests",
            "type": "shell",
            "command": "build\\engine_tests.exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
            },
            "dependsOn": "Build",
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
